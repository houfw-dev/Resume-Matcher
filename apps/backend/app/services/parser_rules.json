  "patterns": {
    "md_date": {
      "pattern": "(?:(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?\\s+\\d{4})(?:\\s*[-–—]\\s*(?:(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?\\s+\\d{4}|Present|Current|Now|Ongoing))?",
      "flags": [
        "IGNORECASE"
      ]
    },
    "month_en": {
      "pattern": "\\b(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "numeric_date": {
      "pattern": "\\d{4}\\s*[年./-]\\s*(?:0?[1-9]|1[0-2])(?!\\d|[./-]\\d)(?:\\s*月)?(?:\\s*[-–—~～]\\s*(?:\\d{4}\\s*[年./-]\\s*(?:0?[1-9]|1[0-2])(?!\\d|[./-]\\d)(?:\\s*月)?|至今|现在|目前|Present|Current|Now|Ongoing))?",
      "flags": [
        "IGNORECASE"
      ]
    },
    "present_marker": {
      "pattern": "至今|现在|目前|Present|Current|Now|Ongoing",
      "flags": [
        "IGNORECASE"
      ]
    },
    "numeric_month_precise": {
      "pattern": "\\d{4}\\s*[年./-]\\s*(?:0?[1-9]|1[0-2])(?!\\d|[./-]\\d)"
    },
    "canon_numeric_point": {
      "pattern": "(\\d{4})\\s*[年./-]\\s*(0?[1-9]|1[0-2])(?!\\d|[./-]\\d)(?:\\s*月)?"
    },
    "canon_bare_year": {
      "pattern": "(?<![\\d.])(\\d{4})(?!\\d|[./-]\\d)"
    },
    "canon_present": {
      "pattern": "至今|现在|目前|Present|Current|Now|Ongoing",
      "flags": [
        "IGNORECASE"
      ]
    },
    "canon_connector_word": {
      "pattern": "\\bto\\b",
      "flags": [
        "IGNORECASE"
      ]
    },
    "canon_trailing_note": {
      "pattern": "^[（(][^（）()]*[)）]\\s*$"
    },
    "markdown_inline_link": {
      "pattern": "!?\\[[^\\]]*\\]\\(\\s*([^)\\s]*)\\s*\\)"
    },
    "bare_url": {
      "pattern": "(?:https?://|www\\.)[^\\s|｜，,；;）)】\\]]+"
    },
    "point_marker": {
      "pattern": "^\\s*(?:\\d{1,2}\\s*[.、)）．:：]|[（(]\\d{1,2}[)）]|[①-⑩]|[•·・●▪▸▹◆■]|[\\-—–]\\s+|[一二三四五六七八九十]{1,3}\\s*[、.．)）])\\s*"
    },
    "md_bold_star": {
      "pattern": "\\*\\*\\s*([^*]+?)\\s*\\*\\*",
      "flags": [
        "DOTALL"
      ]
    },
    "md_bold_under": {
      "pattern": "__\\s*([^_]+?)__",
      "flags": [
        "DOTALL"
      ]
    },
    "md_italic_star": {
      "pattern": "(?<![\\w*])\\*([^*\\s][^*]*?)\\*(?![\\w*])"
    },
    "md_italic_under": {
      "pattern": "(?<![\\w_])_([^_\\s][^_]*?)_(?![\\w_])"
    },
    "md_code": {
      "pattern": "`+([^`]+?)`+"
    },
    "md_strike": {
      "pattern": "~~([^~]+?)~~"
    },
    "md_orphan_bold": {
      "pattern": "\\*\\*|__"
    },
    "md_orphan_strike": {
      "pattern": "~~"
    },
    "github_host": {
      "pattern": "(?:^|\\.)github\\.com$",
      "flags": [
        "IGNORECASE"
      ]
    },
    "edu_cert_item_hint": {
      "pattern": "证书|认证|资格|资质|执照"
    },
    "edu_credential_clause": {
      "pattern": "[；;。\\n，,]+"
    },
    "misfile_cert_item_hint": {
      "pattern": "PMP|CPA|CFA|ACCA|AWS|Azure|Google\\s*Cloud|OCI|ITIL|CKA|Licen[cs]e|Certified|证书|认证|资格|资质|执照|执业|结业证",
      "flags": [
        "IGNORECASE"
      ]
    },
    "misfile_lang_item_hint": {
      "pattern": "英语|日语|韩语|法语|德语|俄语|西班牙语|葡萄牙语|意大利语|阿拉伯语|泰语|越南语|印尼语|马来语|粤语|普通话|汉语|中文|外语|口语|口译|笔译|雅思|IELTS|托福|TOEFL|GRE|GMAT|SAT|TESOL|TEFL|CATTI|CET|大学英语|专四|专八|四级|六级|八级|N[1-5](?![0-9])|English|Japanese|Korean|French|German|Spanish|Mandarin|Cantonese",
      "flags": [
        "IGNORECASE"
      ]
    },
    "misfile_award_item_hint": {
      "pattern": "奖|荣誉|荣获|获奖|奖学金|冠军|亚军|季军|金奖|银奖|铜奖|表彰|勋章|标兵|三好|优秀|先进|奖章|立功|嘉奖|Dean'?s List|Cum Laude|Magna|Summa|Prize|Scholarship|Fellowship|Medal|Honor Roll|Recognition|Champion|Runner[- ]?up|Awards?|Honou?rs",
      "flags": [
        "IGNORECASE"
      ]
    },
    "tech_stack_category": {
      "pattern": "^[一-鿿A-Za-z][一-鿿A-Za-z0-9/（）() -]{0,10}[：:]\\s*\\S"
    },
    "category_sentence": {
      "pattern": "[。；！？!?;]"
    },
    "project_header_field": {
      "pattern": "^\\s*(?:\\d{1,2}\\s*[.、)）．:：]\\s*)?(?P<label>项目规模|团队规模|项目角色|担任角色)\\s*[：:]\\s*(?P<value>.+?)\\s*$"
    },
    "work_department_line": {
      "pattern": "^\\s*(?:[一-鿿][一-鿿A-Za-z0-9（）()·&/+\\- ]{0,13}(?:事业部|事业群|部门|条线|分院|大区|办公室|中心|团队|小组|[部组室科处])|[A-Za-z0-9][A-Za-z0-9 &/+\\-]{1,28}(?:Department|Dept\\.?|Division|Team|Group))(?:[（(][^（）()]{1,12}[）)])?\\s*$"
    },
    "work_department_sentence_punct": {
      "pattern": "[。．.，,；;：:！!？?、…]"
    }
  }
}
